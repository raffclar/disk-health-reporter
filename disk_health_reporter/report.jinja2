<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>S.M.A.R.T. Report</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 20px;
            color: #333;
            line-height: 1.4;
        }
        h1 {
            color: #2c3e50;
            border-bottom: 2px solid #eee;
            padding-bottom: 5px;
        }
        h2 {
            color: #3498db;
            margin-top: 20px;
        }
        .summary {
            margin-bottom: 30px;
        }
        table {
            border-collapse: collapse;
            width: 100%;
            margin-bottom: 30px;
        }
        th, td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: left;
        }
        th {
            background-color: #f2f2f2;
            font-weight: bold;
        }
        tr:nth-child(even) {
            background-color: #f9f9f9;
        }
        .device-info {
            margin-bottom: 15px;
            padding: 10px;
            background-color: #ecf0f1;
            border-radius: 4px;
        }
        .healthy {
            color: green;
            font-weight: bold;
        }
        .failing {
            color: red;
            font-weight: bold;
        }
        .warning {
            color: orange;
            font-weight: bold;
        }
        .footer {
            margin-top: 30px;
            font-size: 0.8em;
            color: #777;
            border-top: 1px solid #eee;
            padding-top: 10px;
        }
    </style>
</head>
<body>
    <h1>S.M.A.R.T. Disk Report</h1>
    <div class="summary">
        <p>Report generated on: {{ timestamp }}</p>
        <p>Hostname: {{ hostname }}</p>
        <p>Number of devices: {{ devices|length }}</p>
    </div>

    {% for device_path, data in devices.items() %}
    <h2>{{ device_path }}</h2>
    <div class="device-info">
        <p><strong>Model:</strong> {{ data.model }}</p>
        <p><strong>Serial:</strong> {{ data.serial }}</p>
        <p><strong>Type:</strong> {{ data.type }}</p>
        <p><strong>Health:</strong>
            {% if data.overall_health == True %}
            <span class="healthy">PASSED</span>
            {% elif data.overall_health == False %}
            <span class="failing">FAILED</span>
            {% else %}
            <span>{{ data.overall_health }}</span>
            {% endif %}
        </p>
        {% if data.temperature %}
        <p><strong>Temperature:</strong>
            {% if data.temperature < 40 %}
            <span class="healthy">{{ data.temperature }}°C</span>
            {% elif data.temperature < 50 %}
            <span class="warning">{{ data.temperature }}°C</span>
            {% else %}
            <span class="failing">{{ data.temperature }}°C</span>
            {% endif %}
        </p>
        {% endif %}
    </div>

    {% if data.attributes %}
    <table>
        <tr>
            <th>ID</th>
            <th>Attribute Name</th>
            <th>Value</th>
            <th>Worst</th>
            <th>Threshold</th>
            <th>Raw Value</th>
            <th>Status</th>
        </tr>
        {% for attr in data.attributes %}
        <tr>
            <td>{{ attr.id }}</td>
            <td>{{ attr.name }}</td>
            <td>{{ attr.value }}</td>
            <td>{{ attr.worst }}</td>
            <td>{{ attr.threshold }}</td>
            <td>{{ attr.raw_value }}</td>
            <td class="{% if attr.status == 'OK' %}healthy{% else %}failing{% endif %}">
                {{ attr.status }}
            </td>
        </tr>
        {% endfor %}
    </table>
    {% else %}
    <p>No S.M.A.R.T. attributes available for this device.</p>
    {% endif %}
    {% endfor %}

    <div class="footer">
        <p>Generated by smart-report tool</p>
    </div>
</body>
</html>
